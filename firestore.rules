rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.role == 'admin'
      );
    }

    // User profiles & private subcollections
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Private user cart
      match /cart/{cartItemId} {
        allow read, write: if isOwner(userId);
      }

      // Private user wishlist
      match /wishlist/{wishlistId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Orders collection - Customers can only read & create their own orders
    match /orders/{orderId} {
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.userEmail == request.auth.token.email);
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Product Catalog & Public metadata
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Brands & Categories
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CMS (Homepage content)
    match /cms/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Store Settings
    match /store_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Product reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
